<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-arm64;linux-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- The C# page's setting (Snippets/ holds the page's code): every switch expression over a FipcResult handles each
       named result -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors> <!-- a FipcResult with no arm fails the build -->
    <NoWarn>$(NoWarn);CS8524</NoWarn> <!-- an unnamed value throws SwitchExpressionException -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../bindings/csharp/Fipc.csproj" />
    <!-- The broadcast's, the work queue's and the service's examples, built into this project's output, where
         BroadcastTests, QueueTests and ServiceTests run them as two processes -->
    <ProjectReference Include="../../../examples/csharp/Publisher/Publisher.csproj" />
    <ProjectReference Include="../../../examples/csharp/Subscriber/Subscriber.csproj" />
    <ProjectReference Include="../../../examples/csharp/Producer/Producer.csproj" />
    <ProjectReference Include="../../../examples/csharp/Consumer/Consumer.csproj" />
    <ProjectReference Include="../../../examples/csharp/ServiceServer/ServiceServer.csproj" />
    <ProjectReference Include="../../../examples/csharp/ServiceClient/ServiceClient.csproj" />
  </ItemGroup>

</Project>
