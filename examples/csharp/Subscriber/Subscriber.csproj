<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console project (dotnet new console). In a project of your own, `dotnet add package Fipc` takes the
       place of the project reference to this repository's binding. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../bindings/csharp/Fipc.csproj" />
  </ItemGroup>

</Project>
